OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
# GEMINI_API_KEY is used for models with 'gemini/' prefix (Google AI Studio)
GEMINI_API_KEY=your_gemini_key_here
# DEFAULT_MODEL can be: gpt-4o, claude-3-5-sonnet-20240620, gemini/gemini-1.5-flash, ollama/llama3, lm_studio/luna-ai-llama2
DEFAULT_MODEL=gpt-4o

# Local LLM Support
# Ollama
OLLAMA_API_BASE=http://localhost:11434
# LM Studio
LM_STUDIO_API_BASE=http://localhost:1234/v1
